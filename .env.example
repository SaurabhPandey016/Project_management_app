# server
# Runtime environment (development, test, or production)
NODE_ENV=development
# HTTP port
PORT=10000
# Pooled PostgreSQL connection string used by the application
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
# Direct PostgreSQL connection string used for migrations
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
# Replace with a long, randomly generated secret
JWT_SECRET=replace-with-a-long-random-secret
# JWT lifetime
JWT_EXPIRES_IN=7d
# Allowed client origin
CLIENT_URL=http://localhost:3000

# client
# Public API endpoint
NEXT_PUBLIC_API_URL=http://localhost:10000
# Public Socket.io endpoint
NEXT_PUBLIC_SOCKET_URL=http://localhost:10000
# Server-side backend endpoint
BACKEND_URL=http://localhost:10000
# Optional demo video URL
NEXT_PUBLIC_DEMO_VIDEO_URL=
# Owner LinkedIn profile
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/saurabhpandey-/
# Owner GitHub profile
NEXT_PUBLIC_GITHUB_URL=https://github.com/SaurabhPandey016
# Contact email
NEXT_PUBLIC_CONTACT_EMAIL=developersaurabh001@gmail.com
