{
  "name": "issueflow-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": "Saurabh Pandey",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
