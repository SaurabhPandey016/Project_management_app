generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

enum IssueType {
  BUG
  FEATURE
  TASK
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  TODO
  IN_PROGRESS
  DONE
}

model User {
  id              String          @id @default(cuid())
  name            String
  email           String          @unique
  passwordHash    String          @map("password_hash")
  avatarColor     String          @map("avatar_color")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  ownedProjects   Project[]       @relation("ProjectOwner")
  memberships     ProjectMember[]
  invitationsSent Invitation[]    @relation("InvitationInviter")
  reportedIssues  Issue[]         @relation("IssueReporter")
  assignedIssues  Issue[]         @relation("IssueAssignee")
  comments        Comment[]

  @@map("users")
}

model Project {
  id           String          @id @default(cuid())
  name         String
  key          String          @unique @db.VarChar(5)
  description  String?
  ownerId      String          @map("owner_id")
  issueCounter Int             @default(0) @map("issue_counter")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  owner        User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members      ProjectMember[]
  invitations  Invitation[]
  issues       Issue[]

  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String      @map("project_id")
  userId    String      @map("user_id")
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now()) @map("joined_at")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Invitation {
  id          String           @id @default(cuid())
  projectId   String           @map("project_id")
  email       String
  role        ProjectRole      @default(MEMBER)
  invitedById String           @map("invited_by_id")
  status      InvitationStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy   User             @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([projectId, email, status])
  @@map("invitations")
}

model Issue {
  id          String        @id @default(cuid())
  projectId   String        @map("project_id")
  number      Int
  title       String
  description String?       @db.Text
  type        IssueType     @default(TASK)
  priority    IssuePriority @default(MEDIUM)
  status      IssueStatus   @default(TODO)
  position    Float         @default(0)
  reporterId  String        @map("reporter_id")
  assigneeId  String?       @map("assignee_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reporter    User          @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  assignee    User?         @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    Comment[]

  @@unique([projectId, number])
  @@index([projectId, status, position])
  @@index([projectId, assigneeId])
  @@index([projectId, priority])
  @@map("issues")
}

model Comment {
  id        String    @id @default(cuid())
  issueId   String    @map("issue_id")
  authorId  String    @map("author_id")
  parentId  String?   @map("parent_id")
  content   String    @db.Text
  isDeleted Boolean   @default(false) @map("is_deleted")
  editedAt  DateTime? @map("edited_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  issue     Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  @@index([issueId, createdAt])
  @@map("comments")
}
